# @name Skoda Pixel Core
# @desc Gemeinsamer Zeichencode fuer mehrere Skoda-Pixel-Anzeigen.
# @module SkodaPixelCoreTC002
# @author Q14siX
# @version 20261113.234847
# @display 52x16

import json

class SkodaPixel
  var spec, row, seen, started, source, row_key, revision
  var issue, issue_color, source_error, demo, local_demo, animate, fetch_epoch
  var stale_minutes, stale, age_unknown, value, heading, ink, bar, motion, glyph, accent, empty
  var brand_pixels, brand_small, full_width, value_font, value_width

  def init()
    var specs = [["battery","Akku","AKKU","percent","battery"],["range","E-Reichweite","E-KM","meters","road"],["charging","Ladestatus","LADEN","charge","bolt"],["power","Ladeleistung","LEIST.","power","bolt"],["speed","Ladetempo","TEMPO","speed","road"],["remaining","Restladezeit","REST","minutes","clock"],["target","Ladeziel","ZIEL","percent","target"],["cable","Ladekabel","KABEL","plug","plug"],["cablelock","Kabelschloss","K-LOCK","cablelock","key"],["locked","Verriegelung","LOCK","locked","lock"],["doors","Tueren","TUER","open","door"],["windows","Fenster","FENST","open","window"],["roof","Schiebedach","DACH","open","roof"],["trunk","Kofferraum","HECK","open","trunk"],["bonnet","Motorhaube","HAUBE","open","bonnet"],["lights","Licht","LICHT","on","light"],["odometer","Kilometerstand","GES-KM","km","car"],["climate","Klima","KLIMA","climate","fan"],["temperature","Solltemperatur","SOLL","temperature","thermo"],["fuel","Tank","TANK","fuel","fuel"],["totalrange","Gesamtreichweite","GESAMT","km","range"],["adblue","AdBlue","ADBLUE","km","drop"],["parking","Parkstatus","PARKEN","parking","park"],["heater","Standheizung","STAND","heater","heat"],["ventilation","Lueftung","LUFT","vent","wind"],["frontheat","Frontscheibenheizung","VORN H","on","frontheat"],["rearheat","Heckscheibenheizung","HECK H","on","rearheat"]]
    var icons = {"battery":[28,62,34,34,34,34,62],"road":[34,34,42,34,42,34,34],"bolt":[12,24,24,62,12,24,16],"clock":[28,34,73,77,65,34,28],"target":[28,34,73,85,73,34,28],"plug":[20,20,62,34,28,8,24],"lock":[28,34,34,127,65,73,127],"door":[60,36,36,44,36,36,60],"window":[63,33,49,41,37,35,63],"roof":[28,34,127,65,93,65,127],"trunk":[6,12,24,126,66,126,36],"bonnet":[48,24,12,63,33,63,18],"light":[6,73,57,73,57,73,6],"car":[28,34,127,65,127,34,0],"fan":[24,25,14,28,56,76,12],"thermo":[24,36,36,36,90,66,60],"fuel":[60,38,38,60,37,37,126],"drop":[8,8,20,34,65,65,62],"park":[62,34,34,62,32,32,32],"heat":[42,21,42,21,42,0,62],"key":[28,34,34,28,8,12,8],"range":[8,12,126,127,126,12,8],"wind":[6,9,126,0,63,72,48],"frontheat":[28,34,73,85,73,65,127],"rearheat":[127,65,85,85,85,65,127]}
    self.brand_pixels = [0,0,0,0,0,11593159,11133122,10738620,10343862,1657657,0,0,0,0,0,0,0,0,11987661,11593159,11133122,6942366,6942366,9949360,9489323,9094821,1657657,0,0,0,0,0,11987661,11593159,0,6744218,6744218,6744218,6744218,0,8700319,8305818,1657657,0,0,0,11987661,11593159,6546070,6546070,0,6546070,6546070,6546070,0,0,7845524,7451022,1657657,0,0,11593159,0,0,6347665,6347665,0,6347665,6347665,6347665,0,0,7056520,1657657,0,11593159,11133122,6214797,6214797,0,6214797,6214797,6214797,6214797,6214797,0,0,6596483,6201981,1657657,11133122,1657657,6016649,6016649,6016649,6016649,6016649,6016649,6016649,6016649,0,0,0,5807223,1657657,10738620,1657657,0,0,5818500,5818500,5818500,5818500,5818500,5818500,0,0,0,5412721,1657657,10343862,9949360,1657657,0,0,5620096,5620096,5620096,0,5620096,0,0,5412721,4952684,1657657,0,9489323,5421692,5421692,5421692,5421692,5421692,5421692,5421692,5421692,5421692,5421692,4952684,1657657,0,0,9094821,8700319,5223544,5223544,5223544,5223544,5223544,5223544,5223544,5223544,4952684,4558182,1657657,0,0,0,8305818,7845524,1657657,0,0,0,0,0,4952684,4558182,1657657,0,0,0,0,0,7451022,7056520,6596483,1657657,0,5412721,4952684,4558182,1657657,0,0,0,0,0,0,0,0,6201981,5807223,5412721,4952684,1657657,0,0,0,0,0]
    self.brand_small = [0,0,0,7927206,7927206,0,0,0,0,7927206,7927206,7927206,0,0,7927206,7927206,0,7927206,7927206,7927206,0,7927206,7927206,7927206,7927206,7927206,7927206,0,0,0,7927206,7927206,0,7927206,0,0,0,7927206,7927206,7927206,7927206,0,4306033,7927206,7927206,7927206,7927206,7927206,7927206]
    self.accent = store.get('accent',0x78F5A6)
    self.local_demo = store.get('demo',false)
    self.demo = self.local_demo
    self.animate = store.get('animation',true)
    self.stale_minutes = int(clamp(store.get('stale',60),10,1440))
    self.empty = ['--',0x758590,-1,0,-1,false,false]
    self.row = self.empty
    self.source = store.get('source','SkodaData')
    if type(self.source) != 'string' || size(self.source) == 0 self.source = 'SkodaData' end
    var view = store.get('view','Akku')
    var migrated = {'Rotation':'Akku','Cockpit':'Akku','Lade-Cockpit':'Ladeleistung','Zugang':'Verriegelung','Klima-Cockpit':'Klima'}.find(view)
    if migrated != nil
      view = migrated
      store.set('view',view)
    end
    var page = 0
    for i : 0 .. size(specs)-1
      if specs[i][1] == view page = i end
    end
    self.spec = specs[page]
    self.glyph = icons[self.spec[4]]
    self.row_key = self.source + '.row_' + self.spec[0]
    self.revision = nil
    self.fetch_epoch = -1
    self.issue = 'WARTEN'
    self.issue_color = 0xFFBC55
    self.source_error = false
    self.seen = false
    self.started = now_ms()
    self.value = '--'
    self.heading = 'AKKU'
    self.ink = self.accent
    self.bar = -1
    self.motion = 0
    self.stale = false
    self.age_unknown = true
    self.full_width = false
    self.value_font = 'large'
    self.value_width = 7
    if self.local_demo
      var examples = [["72%",7927206,72,1,1794556800,true,true],["312km",6475775,-1,3,1794556800,true,false],["LAEDT",7927206,-1,1,1794556800,true,true],["11kW",16759893,-1,1,1794556800,true,false],["58km/h",6475775,-1,3,1794556800,true,false],["36m",16759893,-1,0,1794556800,true,false],["80%",7927206,80,0,1794556800,true,true],["DRAN",7927206,-1,0,1794556800,true,true],["ZU",7927206,-1,0,1794556800,true,true],["ZU",7927206,-1,0,1794556800,true,true],["ZU",7927206,-1,0,1794556800,true,true],["ZU",7927206,-1,0,1794556800,true,true],["ZU",7927206,-1,0,1794556800,true,true],["ZU",7927206,-1,0,1794556800,true,true],["ZU",7927206,-1,0,1794556800,true,true],["AUS",6475775,-1,0,1794556800,true,false],["12845km",6475775,-1,0,1794556800,true,false],["HEIZT",16759893,-1,2,1794556800,true,false],["22°C",6475775,-1,0,1794556800,true,false],["68%",7927206,68,0,1794556800,true,true],["640km",6475775,-1,0,1794556800,true,false],["5200km",6475775,-1,0,1794556800,true,false],["PARKT",7927206,-1,0,-1,true,true],["HEIZT",16759893,-1,2,1794556800,true,false],["LUEFTET",6475775,-1,2,1794556800,true,false],["AN",16759893,-1,1,1794556800,true,false],["AUS",6475775,-1,0,1794556800,true,false]]
      self.row = examples[page]
      examples = nil
      var now = epoch_ms()
      self.fetch_epoch = now > 0 ? now/1000 : -1
      if self.row[4] >= 0 self.row[4] = self.fetch_epoch-240 end
      self.seen = true
      self.issue = ''
      self.apply_row()
    end
  end

  def setup()
    self.loop()
  end

  def loop()
    if self.local_demo
      self.data_age()
      return
    end
    var alive = shared.age(self.source+'.alive')
    if alive == nil || alive > 10000
      self.issue = alive == nil ? 'QUELLE?' : 'QUELLE ALT'
      self.issue_color = 0xFFBC55
      self.source_error = true
      self.revision = nil
      return
    end
    self.issue_color = 0xFFBC55
    var schema = shared.get(self.source+'.schema')
    if type(schema) != 'int' || schema != 1
      self.issue = 'DATEN?'
      self.revision = nil
      return
    end
    # Status kann sich ohne neue Fahrzeugdaten und ohne neue Revision aendern.
    var problem = shared.get(self.source+'.issue')
    if type(problem) != 'string' || size(problem) > 48 problem = 'DATEN?' end
    var tint = shared.get(self.source+'.issue_color')
    if type(tint) == 'int' && tint >= 0 && tint <= 0xFFFFFF self.issue_color = tint end
    self.demo = shared.get(self.source+'.demo') == true
    self.source_error = problem != ''
    var ready = shared.get(self.source+'.ready')
    if type(ready) != 'bool'
      self.issue = 'DATEN?'
      self.revision = nil
      return
    end
    if !ready
      self.row = self.empty
      self.seen = false
      self.issue = problem == '' ? 'WARTEN' : problem
      self.revision = nil
      return
    end
    var revision = shared.get(self.source+'.revision')
    if type(revision) != 'int'
      self.issue = 'WARTEN'
      self.revision = nil
      return
    end
    if revision != self.revision || !self.seen
      try
        var raw = shared.get(self.row_key)
        if type(raw) != 'string' || size(raw) > 1024 raise 'value_error','row' end
        var r = json.load(raw)
        raw = nil
        if !isinstance(r,list) || size(r) != 7 raise 'value_error','row' end
        if type(r[0]) != 'string' || size(r[0]) > 128 raise 'value_error','text' end
        if type(r[1]) != 'int' || r[1] < 0 || r[1] > 0xFFFFFF raise 'value_error','color' end
        if (type(r[2]) != 'int' && type(r[2]) != 'real') || r[2] != r[2] || r[2] < -1 || r[2] > 100 raise 'value_error','percent' end
        if type(r[3]) != 'int' || r[3] < 0 || r[3] > 3 raise 'value_error','motion' end
        if (type(r[4]) != 'int' && type(r[4]) != 'real') || r[4] != r[4] raise 'value_error','timestamp' end
        if type(r[5]) != 'bool' || type(r[6]) != 'bool' raise 'value_error','flags' end
        self.row = r[5] ? r : self.empty
        var fetched = shared.get(self.source+'.fetch_epoch')
        self.fetch_epoch = (type(fetched) == 'int' || type(fetched) == 'real') && fetched == fetched ? fetched : -1
        self.seen = true
        self.apply_row()
        self.revision = revision
      except ..
        self.issue = 'DATEN?'
        self.issue_color = 0xFFBC55
        return
      end
    end
    self.issue = !self.row[5] && problem != '' ? problem : ''
    if self.seen self.data_age() end
  end

  def data_age()
    var r = self.row
    var now = epoch_ms()/1000
    var captured_bad = !r[5] || r[4] < 0 || now <= 0 || r[4] > now+300
    var source_bad = self.fetch_epoch <= 0 || now <= 0 || self.fetch_epoch > now+300
    self.age_unknown = captured_bad || source_bad || (!source_bad && r[4] > self.fetch_epoch+300)
    self.stale = (!captured_bad && now-r[4] > self.stale_minutes*60) || (!source_bad && now-self.fetch_epoch > self.stale_minutes*60)
  end

  def apply_row()
    var row = self.row
    if self.value != row[0] self.started = now_ms() end
    self.value = row[0]
    self.ink = row[6] ? self.accent : row[1]
    self.bar = row[2]
    self.heading = self.spec[2]
    # Bewegungen duerfen nur den gerade gewaehlten Status visualisieren.
    var fmt = self.spec[3]
    self.motion = (fmt == 'charge' || fmt == 'climate' || fmt == 'heater' || fmt == 'vent' || fmt == 'on' || fmt == 'parking') ? row[3] : 0
    font('small')
    self.full_width = text_ink_width(self.value) > 35
    var available = self.full_width ? 52 : 35
    font('large')
    self.value_font = text_ink_width(self.value) <= available ? 'large' : 'small'
    font(self.value_font)
    self.value_width = text_ink_width(self.value)
    self.data_age()
  end

  def on_show()
    self.started = now_ms()
  end

  def brand(small)
    var pixels = small ? self.brand_small : self.brand_pixels
    var w = small ? 7 : 15
    for i : 0 .. size(pixels)-1
      if pixels[i] != 0 pixel(i%w,i/w,pixels[i]) end
    end
  end

  def metric_symbol(x,y)
    var c = self.ink
    if self.animate && self.motion > 0 && int(now_ms()/350)%2 == 1
      c = rgb(((c>>16)&255)*3/5,((c>>8)&255)*3/5,(c&255)*3/5)
    end
    for gy : 0 .. 6
      var bits = self.glyph[gy]
      for gx : 0 .. 6
        if (bits & (1<<(6-gx))) != 0 pixel(x+gx,y+gy,c) end
      end
    end
  end

  def text_x(tw,w)
    if tw <= w return (w-tw)/2 end
    var overflow = tw-w
    var travel = int((overflow*1000+14)/15)
    var elapsed = (now_ms()-self.started) % (3000+2*travel)
    if elapsed < 1500 return 0 end
    if elapsed < 1500+travel return -int((elapsed-1500)*overflow/travel) end
    if elapsed < 3000+travel return -overflow end
    return -overflow+int((elapsed-3000-travel)*overflow/travel)
  end

  def draw()
    clear()
    font('small')
    if self.issue != ''
      self.brand(false)
      text(17+(35-text_ink_width('SKODA'))/2,5,'SKODA',self.accent)
      if text_ink_width(self.issue) <= 35
        text(17+(35-text_ink_width(self.issue))/2,13,self.issue,self.issue_color)
      else
        clear()
        self.brand(true)
        text(10,5,'SKODA PIXEL',self.accent)
        text(self.text_x(text_ink_width(self.issue),52),14,self.issue,self.issue_color)
      end
      return
    end
    if self.full_width
      self.brand(true)
      self.metric_symbol(9,0)
      text(18+(34-text_ink_width(self.heading))/2,5,self.heading,0x91A69F)
    else
      self.brand(false)
      self.metric_symbol(17,0)
      text(26+(26-text_ink_width(self.heading))/2,5,self.heading,0x91A69F)
    end
    font(self.value_font)
    if self.full_width
      var x = self.text_x(self.value_width,52)
      text(x,14,self.value,self.ink)
    else
      text(17+(35-self.value_width)/2,14,self.value,self.ink)
    end
    if self.bar >= 0
      line(17,15,50,15,0x123126)
      var fill = int(34*self.bar/100+0.5)
      if fill > 0 line(17,15,17+fill-1,15,self.ink) end
    end
    if self.stale
      for x : 17 .. 50
        if x%2 == 0 pixel(x,15,0xFFBC55) end
      end
    end
    if self.source_error
      pixel(49,15,0xFFBC55)
      pixel(50,15,0xFFBC55)
    end
    if self.age_unknown pixel(51,15,0xFFBC55) end
  end
end

var exports = module('SkodaPixelCoreTC002')
exports.create = SkodaPixel
return exports
